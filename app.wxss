page {
  min-height: 100%;
  background: #050B16;
  color: #F5F8FF;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

view,
text,
button,
input,
textarea {
  box-sizing: border-box;
  letter-spacing: 0;
}

button {
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
}

.page {
  min-height: 100vh;
  padding: 40rpx 36rpx calc(170rpx + env(safe-area-inset-bottom));
}

.section {
  margin-top: 52rpx;
}

.section-head {
  margin-bottom: 32rpx;
}

.eyebrow {
  display: inline-flex;
  align-items: center;
  min-height: 52rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: rgba(74,139,255,0.12);
  border: 1rpx solid rgba(74,139,255,0.3);
  color: #79A8FF;
}

.h1 {
  display: block;
  margin-top: 22rpx;
  color: #FFFFFF;
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1.35;
}

.h2 {
  color: #FFFFFF;
  font-size: 36rpx;
  font-weight: 600;
}

.lead,
.body {
  display: block;
  margin-top: 18rpx;
  color: #9BAAC4;
  font-size: 28rpx;
  line-height: 1.6;
}

.card {
  border: 1rpx solid rgba(120,160,220,0.18);
  border-radius: 32rpx;
  background: rgba(17,32,57,0.76);
  box-shadow: 0 18rpx 60rpx rgba(0,0,0,0.2);
}

.primary-button {
  display:flex;
  align-items:center;
  justify-content:center;
  min-height:92rpx;
  border-radius:28rpx;
  background:linear-gradient(90deg,#246BFF,#35B8FF);
  color:#fff;
  font-size:30rpx;
  font-weight:600;
}

.secondary-button {
  display:flex;
  align-items:center;
  justify-content:center;
  min-height:92rpx;
  border-radius:28rpx;
  border:1rpx solid rgba(74,139,255,.45);
  color:#BBD3FF;
  background:rgba(255,255,255,.03);
}

.actions {
  display:flex;
  flex-direction:column;
  gap:20rpx;
  margin-top:38rpx;
}

.muted {
  color:#71809B;
}
