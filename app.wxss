page {
  min-height: 100%;
  background: #F7F9FC;
  color: #0B1F3A;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

view,
text,
button,
input,
textarea {
  box-sizing: border-box;
  letter-spacing: 0;
}

button {
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
}

.page {
  min-height: 100vh;
  padding: 34rpx 32rpx calc(150rpx + env(safe-area-inset-bottom));
}

.section {
  margin-top: 42rpx;
}

.section-head {
  margin-bottom: 26rpx;
}

.eyebrow,
.page-kicker,
.section-kicker,
.section-eyebrow {
  color: #176BFF;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1.35;
  letter-spacing: 0.1em;
}

.h1 {
  display: block;
  margin-top: 18rpx;
  color: #081B3A;
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1.3;
}

.h2 {
  color: #081B3A;
  font-size: 36rpx;
  font-weight: 650;
}

.lead,
.body {
  display: block;
  margin-top: 14rpx;
  color: #66789A;
  font-size: 27rpx;
  line-height: 1.65;
}

.card {
  border: 1rpx solid #E3EAF5;
  border-radius: 30rpx;
  background: #FFFFFF;
  box-shadow: 0 14rpx 42rpx rgba(34, 75, 140, 0.08);
}

.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 90rpx;
  border-radius: 24rpx;
  background: linear-gradient(90deg, #176BFF, #2D8CFF);
  color: #FFFFFF;
  font-size: 29rpx;
  font-weight: 650;
  box-shadow: 0 12rpx 30rpx rgba(23, 107, 255, 0.2);
}

.secondary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 90rpx;
  border-radius: 24rpx;
  border: 1rpx solid #CFE0FF;
  color: #176BFF;
  background: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
}

.actions {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 34rpx;
}

.muted {
  color: #7B879B;
}

.placeholder {
  color: #A1ADBE;
}

.pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 42rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #EFF5FF;
  color: #176BFF;
  font-size: 20rpx;
  font-weight: 600;
}

.full-button {
  width: 100%;
}

/* EXPERIENCE_V1_GLOBAL_START */

button::after {
  border: 0;
}

.primary-button,
.secondary-button {
  box-sizing: border-box;
  padding-left: 28rpx;
  padding-right: 28rpx;
  text-align: center;
  line-height: 1.2;
}

.primary-button:active,
.secondary-button:active {
  opacity: 0.88;
}

.primary-button text,
.secondary-button text {
  line-height: 1.2;
  text-align: center;
}
/* EXPERIENCE_V1_GLOBAL_END */
