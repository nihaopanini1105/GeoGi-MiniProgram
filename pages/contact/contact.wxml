<view class="page">
  <view class="contact-hero card">
    <text class="eyebrow">CONTACT GEOGI</text>
    <text class="h1">联系 GeoGi 顾问</text>
    <text class="lead">需要确认诊断范围、资料填写方式或报告解读，可以通过官方渠道联系 GeoGi。</text>
  </view>

  <view class="section info-card card">
    <text class="info-title">企业微信顾问</text>
    <text class="info-hint">扫码添加 GeoGi 顾问，获取诊断咨询与报告解读服务。</text>
    <image class="wecom-qr" src="{{assets.contact.wecomQr}}" mode="aspectFit" bindtap="previewWecomQr"></image>
    <text class="qr-tip">点击二维码放大查看</text>
  </view>

  <view class="section info-card card">
    <text class="info-title">官方邮箱</text>
    <text class="info-copy">{{email}}</text>
    <button class="primary-button copy-button" bindtap="copyEmail">复制邮箱</button>
  </view>

  <view class="section info-card card">
    <text class="info-title">官方网站</text>
    <text class="info-copy">{{website}}</text>
    <button class="secondary-button copy-button" bindtap="copyWebsite">复制官网地址</button>
  </view>

  <view class="section info-card card">
    <text class="info-title">提交品牌资料</text>
    <text class="info-hint">如需开始新的品牌初步诊断，可直接进入诊断页面填写资料。</text>
    <button class="secondary-button copy-button" bindtap="goDiagnosis">开始品牌初步诊断</button>
  </view>
</view>
