.contact-hero {
  padding: 34rpx 30rpx;
}

.info-title,
.info-copy,
.info-hint,
.qr-tip {
  display: block;
}

.info-card {
  padding: 30rpx;
}

.info-title {
  color: #081B3A;
  font-size: 34rpx;
  font-weight: 600;
}

.info-copy {
  margin: 12rpx 0 24rpx;
  color: #66789A;
  font-size: 28rpx;
}

.info-hint {
  margin: 10rpx 0 24rpx;
  color: #66789A;
  font-size: 24rpx;
  line-height: 1.5;
}

.wecom-qr {
  display: block;
  width: 420rpx;
  height: 420rpx;
  margin: 8rpx auto 0;
  border-radius: 26rpx;
  background: #F4F8FF;
}

.qr-tip {
  margin-top: 16rpx;
  color: #8A97A9;
  font-size: 21rpx;
  text-align: center;
}

.copy-button {
  width: 100%;
}
