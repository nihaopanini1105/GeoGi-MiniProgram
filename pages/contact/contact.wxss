.contact-hero {
  padding: 34rpx 30rpx;
}

.info-title,
.info-copy,
.info-hint {
  display: block;
}

.info-card {
  padding: 30rpx;
}

.info-title {
  color: #081B3A;
  font-size: 34rpx;
  font-weight: 600;
}

.info-copy {
  margin: 12rpx 0 24rpx;
  color: #66789A;
  font-size: 28rpx;
  word-break: break-all;
}

.info-hint {
  margin: 10rpx 0 24rpx;
  color: #66789A;
  font-size: 24rpx;
  line-height: 1.5;
  text-align: center;
}

.action-hint {
  text-align: left;
}

.wecom-qr {
  display: block;
  width: 360rpx;
  height: 360rpx;
  margin: 26rpx auto 12rpx;
  border-radius: 20rpx;
  background: #FFFFFF;
}

.copy-button {
  width: 100%;
}
