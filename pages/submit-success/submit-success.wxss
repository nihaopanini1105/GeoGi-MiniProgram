.success-page { background:#F7F9FC; }
.success-hero,.identity-card,.consult-card,.process-card,.report-card,.payment-card { padding:34rpx 30rpx; }
.success-hero { background:linear-gradient(150deg,#FFFFFF,#F4F8FF); }
.success-mark { display:flex; align-items:center; justify-content:center; width:88rpx; height:88rpx; border-radius:50%; background:#EAF2FF; color:#176BFF; font-size:50rpx; font-weight:700; }
.success-kicker,.section-kicker { display:block; margin-top:26rpx; color:#176BFF; font-size:20rpx; font-weight:700; letter-spacing:.1em; }
.success-title { display:block; margin-top:12rpx; color:#081B3A; font-size:42rpx; font-weight:700; line-height:1.35; }
.success-copy { display:block; margin-top:16rpx; color:#66789A; font-size:25rpx; line-height:1.65; }
.status-row { display:flex; align-items:center; justify-content:space-between; margin-top:30rpx; padding:22rpx; border:1rpx solid #DDE7F5; border-radius:22rpx; background:#FAFCFF; }
.status-label { display:block; color:#8A97A9; font-size:21rpx; }
.status-value { display:block; margin-top:6rpx; color:#0B1F3A; font-size:29rpx; font-weight:650; }
.status-dot { width:16rpx; height:16rpx; border-radius:50%; background:#176BFF; box-shadow:0 0 0 8rpx rgba(23,107,255,.08); }
.section-title { display:block; margin-top:10rpx; color:#081B3A; font-size:33rpx; font-weight:650; }
.identity-list,.process-list { margin-top:22rpx; }
.identity-row { display:flex; justify-content:space-between; gap:20rpx; padding:18rpx 0; border-bottom:1rpx solid #EDF1F7; }
.identity-label { color:#7B879B; font-size:23rpx; }
.identity-value { color:#20324F; font-size:23rpx; font-weight:600; text-align:right; }
.project-id { color:#176BFF; }



.process-row { display:flex; gap:18rpx; padding:20rpx 0; border-bottom:1rpx solid #EDF1F7; }
.process-index { color:#176BFF; font-size:21rpx; font-weight:700; }
.process-copy text { display:block; }
.process-title { color:#20324F; font-size:26rpx; font-weight:600; }
.process-desc { margin-top:7rpx; color:#7B879B; font-size:22rpx; line-height:1.5; }
.report-title { display:block; color:#081B3A; font-size:29rpx; font-weight:650; }
.report-copy { display:block; margin-top:10rpx; color:#66789A; font-size:23rpx; line-height:1.6; }
.full-button { width:100%; margin-top:24rpx; }
.secondary-action { margin-top:14rpx; }

.payment-card { border:1rpx solid #D9E6FA; background:linear-gradient(180deg,#FFFFFF,#F8FBFF); }
.payment-head { display:flex; justify-content:space-between; gap:24rpx; align-items:flex-end; }
.payment-price { color:#176BFF; font-size:52rpx; font-weight:750; line-height:1; }
.payment-copy { display:block; margin-top:18rpx; color:#5F718F; font-size:24rpx; line-height:1.65; }
.payment-points { display:grid; gap:12rpx; margin-top:20rpx; padding:20rpx; border-radius:20rpx; background:#F6F9FE; }
.payment-points text { position:relative; padding-left:24rpx; color:#314766; font-size:23rpx; line-height:1.5; }
.payment-points text::before { content:'✓'; position:absolute; left:0; top:0; color:#176BFF; font-weight:700; }
.pay-button { margin-top:26rpx; }
.paid-banner { margin-top:24rpx; padding:20rpx 22rpx; border-radius:18rpx; background:#EEF8F2; color:#2E7B4A; font-size:25rpx; font-weight:650; text-align:center; }
.payment-error { display:block; margin-top:14rpx; color:#C23B3B; font-size:22rpx; line-height:1.5; }
.status-dot.pending { background:#F2A93B; box-shadow:0 0 0 8rpx rgba(242,169,59,.10); }
.status-dot.paid { background:#3AA76D; box-shadow:0 0 0 8rpx rgba(58,167,109,.10); }
