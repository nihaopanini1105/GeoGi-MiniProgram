<view class="page success-page">
  <view class="success-hero card">
    <view class="success-mark">✓</view>
    <text class="success-kicker">资料提交成功</text>
    <text class="success-title">品牌资料已提交</text>
    <text class="success-copy">本次服务为「GeoGi 品牌 GEO 诊断报告」，价格 199 元。完成微信支付后，GeoGi 才会开始本次诊断。</text>

    <view class="status-row">
      <view>
        <text class="status-label">当前状态</text>
        <text class="status-value">{{submission.paymentStatus || '待支付'}}</text>
      </view>
      <view class="status-dot"></view>
    </view>
  </view>

  <view class="section payment-card card">
    <view class="payment-head">
      <view>
        <text class="section-kicker">诊断报告服务</text>
        <text class="section-title">{{submission.productName || product.name}}</text>
      </view>
      <text class="payment-price">¥199</text>
    </view>
    <text class="payment-copy">包含品牌企业资料研究、中国主流 AI 平台检测、GEO 诊断分析和正式诊断报告。GEO 优化实施、代运营或持续监测不包含在本次 199 元诊断报告服务内。</text>
    <button wx:if="{{submission.paymentStatusCode !== 'PAID' && submission.paymentStatus !== '已支付'}}" class="primary-button full-button" loading="{{paymentLoading}}" disabled="{{paymentLoading}}" bindtap="payNow">立即支付 ¥199</button>
    <view wx:else class="paid-state">
      <text class="paid-title">已支付 ¥199</text>
      <text class="paid-copy">GeoGi 已收到付款，将开始本次品牌 GEO 诊断。</text>
    </view>
    <text wx:if="{{paymentMessage}}" class="payment-message">{{paymentMessage}}</text>
  </view>

  <view class="section identity-card card">
    <text class="section-kicker">诊断订单</text>
    <text class="section-title">订单信息</text>
    <view class="identity-list">
      <view class="identity-row" wx:if="{{submission.clientId}}">
        <text class="identity-label">客户编号</text>
        <text class="identity-value">{{submission.clientId}}</text>
      </view>
      <view class="identity-row" wx:if="{{submission.projectId}}">
        <text class="identity-label">诊断编号</text>
        <text class="identity-value project-id">{{submission.projectId}}</text>
      </view>
      <view class="identity-row">
        <text class="identity-label">服务金额</text>
        <text class="identity-value">¥199.00</text>
      </view>
      <view class="identity-row" wx:if="{{submittedAtText}}">
        <text class="identity-label">资料提交时间</text>
        <text class="identity-value">{{submittedAtText}}</text>
      </view>
    </view>
  </view>

  <view class="section process-card card">
    <text class="section-kicker">付款后的流程</text>
    <text class="section-title">接下来 GeoGi 会完成</text>
    <view class="process-list">
      <view class="process-row" wx:for="{{nextSteps}}" wx:key="title">
        <view class="process-index">0{{index + 1}}</view>
        <view class="process-copy">
          <text class="process-title">{{item.title}}</text>
          <text class="process-desc">{{item.desc}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="section report-card card">
    <text class="report-title">诊断报告完成后会出现在「报告」中</text>
    <text class="report-copy">报告由 GeoGi 基于实际品牌资料和 AI 平台检测结果生成并审核后发布。</text>
    <button class="primary-button full-button" bindtap="goReport">查看订单与报告状态</button>
    <button class="secondary-button full-button secondary-action" bindtap="goHome">返回首页</button>
  </view>
</view>
