<view class="page report-page">
  <view wx:if="{{loading}}" class="state-card card">
    <image class="state-icon" src="/assets/icons/png/96/report.png" mode="aspectFit"></image>
    <text class="state-title">正在读取报告</text>
    <text class="body">正在同步 GeoGi OS 交付状态。</text>
  </view>

  <view wx:elif="{{error}}" class="state-card card">
    <image class="state-icon" src="/assets/icons/png/96/info.png" mode="aspectFit"></image>
    <text class="state-title">暂时无法查看</text>
    <text class="body">{{error}}</text>
    <button class="primary-button full-button" bindtap="refresh">重新读取</button>
    <button class="secondary-button full-button" bindtap="goMine">返回报告</button>
  </view>

  <block wx:else>
    <view class="report-hero card">
      <text class="eyebrow">GEOGI OS DELIVERY</text>
      <text class="h1">{{report.title}}</text>
      <text class="lead">{{report.summary}}</text>
      <view class="report-meta">
        <text>项目编号：{{order.projectId}}</text>
        <text>状态：{{report.status}}</text>
        <text wx:if="{{report.version}}">报告版本：{{report.version}}</text>
        <text wx:if="{{report.updatedAt}}">更新时间：{{report.updatedAt}}</text>
      </view>
    </view>

    <block wx:if="{{order.reportReady}}">
      <view wx:if="{{report.previewImageUrl}}" class="section card">
        <text class="block-title">报告预览</text>
        <image class="report-preview-image" src="{{report.previewImageUrl}}" mode="widthFix" bindtap="previewImage"></image>
      </view>

      <view class="section card">
        <text class="block-title">正式交付物</text>
        <text class="body">以下文件由 GeoGi OS 生成、审核并发布。小程序只负责展示，不会重新计算或修改报告内容。</text>
        <button wx:if="{{report.reportLink}}" class="primary-button full-button pdf-button" bindtap="openPdf">打开正式 PDF 报告</button>
        <view wx:if="{{!report.reportLink}}" class="state-card compact">
          <text class="state-title">PDF暂未发布</text>
          <text class="body">GeoGi OS 已生成交付记录，但当前没有可展示的 PDF 文件。</text>
        </view>
      </view>

      <view class="section card" wx:if="{{report.deliveryPackageId}}">
        <text class="block-title">交付版本</text>
        <view class="scope-row"><text>Delivery Package：{{report.deliveryPackageId}}</text></view>
        <view class="scope-row" wx:if="{{report.reportId}}"><text>Report：{{report.reportId}}</text></view>
      </view>
    </block>

    <view wx:else class="section card state-card compact">
      <text class="state-title">报告尚未发布</text>
      <text class="body">GeoGi OS 正在完成品牌研究、AI 平台检测、评分、报告与人工审核。正式交付物发布后会自动出现在这里。</text>
    </view>
  </block>
</view>
