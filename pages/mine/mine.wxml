<view class="page mine-page">
  <view class="mine-head card">
    <view class="mine-copy">
      <text class="eyebrow">GEOGI REPORTS</text>
      <text class="h1">诊断报告</text>
      <text class="lead">查看 199 元品牌 GEO 诊断报告的付款状态、诊断进度和正式报告。</text>
    </view>
</view>

  <view wx:if="{{clientId}}" class="client-card card">
    <text class="client-label">客户编号</text>
    <text class="client-id">{{clientId}}</text>
  </view>

  <text wx:if="{{error}}" class="error-tip">{{error}}</text>

  <view wx:if="{{orders.length}}" class="section order-list">
    <view class="order-card card" wx:for="{{orders}}" wx:key="projectId" data-project-id="{{item.projectId}}" data-client-id="{{item.clientId}}" bindtap="openReport">
      <view class="order-top">
        <view class="order-title-wrap">
          <text class="order-brand">{{item.brandName || '品牌诊断'}}</text>
          <text class="order-meta">{{item.industry}} {{item.segment}}</text>
        </view>
        <text class="status-pill {{item.reportReady ? 'ready' : ''}}">{{item.status}}</text>
      </view>
      <view class="order-info">
        <text>诊断编号：{{item.projectId}}</text>
        <text wx:if="{{item.submittedAt}}">提交时间：{{item.submittedAt}}</text>
        <text wx:if="{{item.paymentRequired}}">诊断报告：¥{{item.amountYuan || '199.00'}} · {{item.paymentStatus || item.status}}</text>
      </view>
      <view class="order-action">
        <text>{{item.reportReady ? '查看完整诊断报告' : (item.status === '待支付' ? '继续支付 ¥199' : '查看订单与诊断进度')}}</text>
        <text class="arrow">›</text>
      </view>
    </view>
  </view>

  <view wx:if="{{!orders.length}}" class="empty-card card">
    <image class="empty-icon" src="/assets/icons/png/96/report.png" mode="aspectFit"></image>
    <text class="empty-title">还没有诊断记录</text>
    <text class="body">提交品牌资料并支付 199 元后，诊断进度和正式报告会出现在这里。</text>
    <button class="primary-button full-button" bindtap="goDiagnosis">获取 ¥199 诊断报告</button>
  </view>
</view>
