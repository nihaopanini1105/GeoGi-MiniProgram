<view class="page mine-page">
  <view class="mine-head card">
    <view class="mine-copy">
      <text class="eyebrow">MY GEOGI</text>
      <text class="h1">我的</text>
      <text class="lead">查看你的品牌 GEO 诊断订单、结果提醒、处理进度和正式报告。</text>
    </view>
</view>

  <view wx:if="{{!phoneAuthorized}}" class="client-card card">
    <text class="client-label">查看我的订单与渠道数据</text>
    <text class="channel-desc">授权手机号后，可查看诊断进度；如果该手机号已绑定为渠道负责人，还会显示渠道推广与返佣数据。</text>
    <button class="primary-button full-button" open-type="getPhoneNumber" bindgetphonenumber="onGetPhoneNumber" loading="{{authLoading}}">授权手机号查看</button>
    <text wx:if="{{authError}}" class="error-tip">{{authError}}</text>
  </view>

  <view wx:if="{{clientId}}" class="client-card card">
    <text class="client-label">客户编号</text>
    <text class="client-id">{{clientId}}</text>
  </view>

  <text wx:if="{{error}}" class="error-tip">{{error}}</text>

  <view wx:if="{{channelDashboard && channelDashboard.isChannel}}" class="section channel-section">
    <view class="channel-head card">
      <text class="eyebrow">CHANNEL PARTNER</text>
      <text class="channel-title">我的推广与返佣</text>
      <text class="channel-desc">仅显示你名下渠道的推广、成交、报告完成和月度返佣数据。</text>
    </view>

    <view class="channel-card card" wx:for="{{channelDashboard.channels}}" wx:key="channelId">
      <view class="channel-card-top">
        <view>
          <text class="channel-name">{{item.name}}</text>
          <text class="channel-code">客户优惠：{{item.discountText}}</text>
        </view>
        <text class="channel-status">{{item.active ? '生效中' : '已停用'}}</text>
      </view>
      <view class="channel-rule-row">
        <view><text>客户优惠</text><strong>{{item.discountText}}</strong></view>
        <view><text>返佣比例</text><strong>{{item.commissionText}}</strong></view>
      </view>
      <view class="channel-metrics">
        <view><strong>{{item.visits}}</strong><text>来源访问</text></view>
        <view><strong>{{item.promotedOrders}}</strong><text>诊断提交</text></view>
        <view><strong>{{item.paidOrders}}</strong><text>已成交</text></view>
        <view><strong>{{item.completedReports}}</strong><text>报告完成</text></view>
      </view>
      <button
        wx:if="{{item.shareSourceToken}}"
        class="secondary-button full-button channel-share-button"
        open-type="share"
        data-source-token="{{item.shareSourceToken}}"
        data-channel-name="{{item.name}}"
      >分享专属入口</button>
      <view class="channel-commission-row">
        <view><text>待返佣</text><strong>¥{{item.pendingCommissionYuan}}</strong></view>
        <view><text>已返佣</text><strong>¥{{item.paidCommissionYuan}}</strong></view>
      </view>
      <text wx:if="{{item.startsAt || item.endsAt}}" class="channel-validity">有效期：{{item.startsAtText || '立即生效'}} 至 {{item.endsAtText || '长期有效'}}</text>
    </view>

    <view wx:if="{{channelDashboard.recentOrders.length}}" class="channel-monthly card">
      <text class="channel-monthly-title">推广明细</text>
      <view class="channel-order-row" wx:for="{{channelDashboard.recentOrders}}" wx:key="projectId">
        <view>
          <text class="channel-order-brand">{{item.brandName || '品牌诊断'}}</text>
          <text class="channel-order-meta">{{item.createdAtText}} · {{item.sourceName || '渠道分享'}}</text>
        </view>
        <view class="channel-order-side">
          <text>¥{{item.paidAmountYuan}}</text>
          <text>{{item.statusText}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{channelDashboard.monthly.length}}" class="channel-monthly card">
      <text class="channel-monthly-title">月度统计</text>
      <view class="channel-month-row channel-month-head">
        <text>月份</text><text>成交</text><text>报告完成</text><text>待返佣</text><text>已返佣</text>
      </view>
      <view class="channel-month-row" wx:for="{{channelDashboard.monthly}}" wx:key="period">
        <text>{{item.period}}</text>
        <text>{{item.paidOrders}}</text>
        <text>{{item.completedReports}}</text>
        <text>¥{{item.pendingCommissionYuan}}</text>
        <text>¥{{item.paidCommissionYuan}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{notifications.length}}" class="section notification-section">
    <view class="notification-head">
      <text class="notification-title">结果提醒</text>
      <text class="notification-desc">退款结果、诊断报告完成等重要状态会在这里更新。</text>
    </view>
    <view
      class="notification-card card"
      wx:for="{{notifications}}"
      wx:key="id"
      data-project-id="{{item.projectId}}"
      data-client-id="{{item.clientId}}"
      bindtap="openNotification"
    >
      <view class="notification-dot {{item.type}}"></view>
      <view class="notification-copy">
        <text class="notification-card-title">{{item.title}}</text>
        <text class="notification-message">{{item.message}}</text>
        <text wx:if="{{item.occurredAtText}}" class="notification-time">{{item.occurredAtText}}</text>
      </view>
      <text class="notification-action">{{item.actionText || '查看'}}</text>
    </view>
  </view>

  <view wx:if="{{orders.length}}" class="section order-list">
    <view class="order-card card" wx:for="{{orders}}" wx:key="projectId" data-project-id="{{item.projectId}}" data-client-id="{{item.clientId}}" bindtap="openReport">
      <view class="order-top">
        <view class="order-title-wrap">
          <text class="order-brand">{{item.brandName || '品牌诊断'}}</text>
          <text class="order-meta">{{item.industry}} {{item.segment}}</text>
        </view>
        <text class="status-pill {{item.reportReady ? 'ready' : ''}}">{{item.status}}</text>
      </view>
      <view class="order-info">
        <text>诊断编号：{{item.projectId}}</text>
        <text wx:if="{{item.submittedAt}}">提交时间：{{item.submittedAt}}</text>
        <text>订单金额：¥{{item.amountYuan !== undefined ? item.amountYuan : 199}}</text>
        <text>付款状态：{{item.paymentStatus === 'free' ? '优惠免付' : item.paymentStatus === 'paid' ? '已付款' : item.paymentStatus === 'partially_refunded' ? '部分退款' : item.paymentStatus === 'refunded' ? '已退款' : item.paymentStatus === 'refund_processing' ? '退款处理中' : item.paymentStatus === 'paying' ? '付款确认中' : '待付款'}}</text>
      </view>
      <view class="order-action">
        <text>{{item.reportReady ? '查看完整诊断报告' : (item.paymentStatus === 'free' || item.paymentStatus === 'paid' || item.paymentStatus === 'partially_refunded' ? '查看诊断进度' : '去付款 / 查看订单')}}</text>
        <text class="arrow">›</text>
      </view>
    </view>
  </view>

  <view wx:if="{{phoneAuthorized && !orders.length && !(channelDashboard && channelDashboard.isChannel)}}" class="empty-card card">
    <image class="empty-icon" src="/assets/icons/png/96/report.png" mode="aspectFit"></image>
    <text class="empty-title">还没有诊断记录</text>
    <text class="body">提交品牌资料后，订单优惠与付款状态、诊断进度和正式报告都会出现在这里。</text>
    <button class="primary-button full-button" bindtap="goDiagnosis">获取诊断报告</button>
  </view>
</view>
