.mine-page {
  padding-bottom: 96rpx;
}

.mine-head,
.client-card,
.order-card,
.empty-card {
  padding: 32rpx 30rpx;
}

.mine-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.mine-head .h1 {
  font-size: 54rpx;
}

.mine-head .lead {
  max-width: 450rpx;
}

.refresh-button {
  flex: 0 0 auto;
  min-width: 120rpx;
  min-height: 64rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: rgba(47, 109, 255, 0.1);
  color: #2F6DFF;
  font-size: 24rpx;
  font-weight: 600;
}

.client-card {
  margin-top: 24rpx;
}

.client-label {
  display: block;
  color: #66789A;
  font-size: 24rpx;
  font-weight: 600;
}

.client-id {
  display: block;
  margin-top: 8rpx;
  color: #081B3A;
  font-size: 34rpx;
  font-weight: 600;
}

.error-tip {
  display: block;
  margin: 22rpx 4rpx 0;
  color: #b45b20;
  font-size: 24rpx;
  line-height: 1.6;
}

.order-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.order-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.order-title-wrap {
  min-width: 0;
}

.order-brand {
  display: block;
  color: #081B3A;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.25;
}

.order-meta {
  display: block;
  margin-top: 10rpx;
  color: #66789A;
  font-size: 25rpx;
  line-height: 1.5;
}

.status-pill {
  flex: 0 0 auto;
  max-width: 210rpx;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(107, 120, 151, 0.11);
  color: #66789A;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.25;
  text-align: center;
}

.status-pill.ready {
  background: rgba(47, 109, 255, 0.12);
  color: #2F6DFF;
}

.order-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-top: 24rpx;
  color: #66789A;
  font-size: 24rpx;
  line-height: 1.5;
}

.order-action {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 26rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid #ecf1fa;
  color: #2F6DFF;
  font-size: 27rpx;
  font-weight: 600;
}

.arrow {
  color: #8da0bf;
  font-size: 40rpx;
  line-height: 1;
}

.empty-card {
  margin-top: 34rpx;
  text-align: center;
}

.empty-icon {
  width: 104rpx;
  height: 104rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  display: block;
  color: #081B3A;
  font-size: 36rpx;
  font-weight: 600;
}

.empty-card .body {
  display: block;
  margin-top: 14rpx;
}

.full-button {
  width: 100%;
  margin-top: 30rpx;
}

/* EXPERIENCE_V1_REPORT_START */

.mine-page {
  padding-top: 30rpx;
}

.mine-head {
  display: block;
  padding: 36rpx 32rpx;
}

.mine-head .h1 {
  margin-top: 18rpx;
  font-size: 52rpx;
  line-height: 1.25;
}

.mine-head .lead {
  max-width: none;
  margin-top: 16rpx;
  line-height: 1.65;
}

.refresh-button {
  display: none;
}

.pull-refresh-hint {
  display: block;
  margin-top: 18rpx;
  color: #96A3B6;
  font-size: 21rpx;
  line-height: 1.45;
}

.order-list {
  gap: 18rpx;
  margin-top: 28rpx;
}

.order-card {
  padding: 30rpx;
  border-color: #E5ECF5;
  box-shadow: 0 10rpx 30rpx rgba(32, 70, 130, 0.055);
}

.order-card:active {
  background: #FAFCFF;
}

.order-brand {
  line-height: 1.35;
}

.order-meta {
  color: #7A899F;
  font-size: 23rpx;
}

.status-pill {
  padding: 10rpx 16rpx;
  font-size: 21rpx;
}

.order-action {
  margin-top: 24rpx;
  padding-top: 20rpx;
}

.empty-card {
  margin-top: 28rpx;
  padding: 54rpx 34rpx 46rpx;
}

.empty-icon {
  width: 92rpx;
  height: 92rpx;
  margin-bottom: 22rpx;
}

.empty-card .body {
  margin: 16rpx auto 0;
  max-width: 560rpx;
}

.empty-card .full-button {
  display: flex;
  align-items: center;
  justify-content: center;
  max-width: 430rpx;
  margin: 30rpx auto 0;
  text-align: center;
}
/* EXPERIENCE_V1_REPORT_END */


.notification-section {
  margin-top: 28rpx;
}

.notification-head {
  padding: 0 4rpx 14rpx;
}

.notification-title {
  display: block;
  color: #081B3A;
  font-size: 32rpx;
  font-weight: 600;
}

.notification-desc {
  display: block;
  margin-top: 8rpx;
  color: #7A899F;
  font-size: 23rpx;
  line-height: 1.5;
}

.notification-card {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  margin-top: 14rpx;
  padding: 26rpx 24rpx;
  border-color: #E5ECF5;
}

.notification-dot {
  width: 16rpx;
  height: 16rpx;
  flex: 0 0 auto;
  margin-top: 10rpx;
  border-radius: 50%;
  background: #2F6DFF;
}

.notification-dot.refund_completed,
.notification-dot.refund_partial {
  background: #34A36F;
}

.notification-dot.refund_processing {
  background: #D48A27;
}

.notification-copy {
  flex: 1;
  min-width: 0;
}

.notification-card-title {
  display: block;
  color: #081B3A;
  font-size: 28rpx;
  font-weight: 600;
}

.notification-message {
  display: block;
  margin-top: 8rpx;
  color: #66789A;
  font-size: 23rpx;
  line-height: 1.55;
}

.notification-time {
  display: block;
  margin-top: 10rpx;
  color: #96A3B6;
  font-size: 21rpx;
}

.notification-action {
  flex: 0 0 auto;
  margin-top: 2rpx;
  color: #2F6DFF;
  font-size: 23rpx;
  font-weight: 600;
}


.channel-section {
  margin-top: 28rpx;
}

.channel-head,
.channel-card,
.channel-monthly {
  padding: 30rpx;
}

.channel-title {
  display: block;
  margin-top: 12rpx;
  color: #081B3A;
  font-size: 38rpx;
  font-weight: 700;
}

.channel-desc {
  display: block;
  margin-top: 10rpx;
  color: #66789A;
  font-size: 23rpx;
  line-height: 1.6;
}

.channel-card {
  margin-top: 16rpx;
}

.channel-card-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 18rpx;
}

.channel-name {
  display: block;
  color: #081B3A;
  font-size: 30rpx;
  font-weight: 650;
}

.channel-code {
  display: block;
  margin-top: 8rpx;
  color: #2F6DFF;
  font-size: 24rpx;
  font-weight: 600;
}

.channel-status {
  flex: 0 0 auto;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #EAF7F0;
  color: #2D8A5C;
  font-size: 20rpx;
  font-weight: 600;
}

.channel-rule-row,
.channel-commission-row {
  display: grid;
  grid-template-columns: repeat(2,minmax(0,1fr));
  gap: 12rpx;
  margin-top: 22rpx;
}

.channel-rule-row > view,
.channel-commission-row > view {
  padding: 18rpx;
  border-radius: 16rpx;
  background: #F7F9FC;
}

.channel-rule-row text,
.channel-commission-row text {
  display: block;
  color: #7A899F;
  font-size: 21rpx;
}

.channel-rule-row strong,
.channel-commission-row strong {
  display: block;
  margin-top: 8rpx;
  color: #20324F;
  font-size: 28rpx;
}

.channel-commission-row strong {
  color: #176BFF;
}

.channel-metrics {
  display: grid;
  grid-template-columns: repeat(4,minmax(0,1fr));
  gap: 10rpx;
  margin-top: 18rpx;
}

.channel-metrics > view {
  padding: 16rpx 8rpx;
  border: 1rpx solid #E3EAF5;
  border-radius: 16rpx;
  text-align: center;
}

.channel-metrics strong,
.channel-metrics text {
  display: block;
}

.channel-metrics strong {
  color: #081B3A;
  font-size: 30rpx;
}

.channel-metrics text {
  margin-top: 5rpx;
  color: #7A899F;
  font-size: 20rpx;
}

.channel-validity {
  display: block;
  margin-top: 18rpx;
  color: #8A97A9;
  font-size: 20rpx;
  line-height: 1.5;
}

.channel-monthly {
  margin-top: 16rpx;
  overflow-x: auto;
}

.channel-monthly-title {
  display: block;
  margin-bottom: 18rpx;
  color: #081B3A;
  font-size: 29rpx;
  font-weight: 650;
}

.channel-month-row {
  display: grid;
  grid-template-columns: 1.1fr .7fr .9fr 1fr 1fr;
  gap: 8rpx;
  min-width: 620rpx;
  padding: 14rpx 0;
  border-top: 1rpx solid #EDF1F7;
  color: #5F6F87;
  font-size: 21rpx;
}

.channel-month-head {
  border-top: 0;
  color: #8A97A9;
  font-size: 19rpx;
  font-weight: 600;
}


.channel-share-button {
  margin-top: 18rpx;
}

.channel-order-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid #EDF1F7;
}

.channel-order-brand {
  display: block;
  color: #20324F;
  font-size: 25rpx;
  font-weight: 600;
}

.channel-order-meta {
  display: block;
  margin-top: 7rpx;
  color: #8A97A9;
  font-size: 20rpx;
}

.channel-order-side {
  flex: 0 0 auto;
  text-align: right;
}

.channel-order-side text {
  display: block;
  color: #20324F;
  font-size: 22rpx;
}

.channel-order-side text + text {
  margin-top: 5rpx;
  color: #66789A;
  font-size: 19rpx;
}
