.diagnosis-page { padding-top: 20rpx; background: #F7F9FC; }
.page-kicker,.section-kicker { display:block; color:#176BFF; font-size:20rpx; font-weight:700; letter-spacing:.1em; }
.auth-card,.intro-hero,.platform-card,.outcome-card,.note-card,.step-card,.form-card { padding:32rpx; }
.auth-card,.intro-hero,.platform-card,.outcome-card,.note-card,.step-card,.form-card { background:#FFFFFF; border:1rpx solid #E3EAF5; border-radius:30rpx; box-shadow:0 14rpx 42rpx rgba(34,75,140,.07); }
.intro-hero { position:relative; min-height:440rpx; overflow:hidden; background:linear-gradient(150deg,#FFFFFF,#F5F9FF); }
.intro-copy { position:relative; z-index:3; max-width:540rpx; }
.intro-title,.form-page-title { margin-top:16rpx; color:#081B3A; font-size:42rpx; font-weight:700; line-height:1.32; }
.intro-lead,.form-page-copy { margin-top:16rpx; color:#66789A; font-size:26rpx; line-height:1.65; }
.intro-button,.auth-button { width:100%; min-height:94rpx; margin-top:38rpx; }
.phone-auth-box { padding:22rpx; border:1rpx solid #DCE5F1; border-radius:20rpx; background:#FBFCFE; }
.phone-auth-copy { display:block; color:#66789A; font-size:23rpx; line-height:1.6; }
.phone-auth-button { margin-top:20rpx; }
.privacy-trust { margin-top:28rpx; padding:18rpx; border-radius:16rpx; background:#F7FAFF; color:#66789A; font-size:22rpx; line-height:1.5; }
.platform-grid { display:flex; justify-content:space-between; align-items:flex-start; }
.platform-item { display:flex; flex-direction:column; align-items:center; width:20%; color:#52627A; font-size:20rpx; text-align:center; }
.platform-icon-wrap { display:flex; align-items:center; justify-content:center; width:72rpx; height:72rpx; margin-bottom:10rpx; border:1rpx solid #E1E9F5; border-radius:20rpx; background:#FFF; }
.platform-icon-wrap image { width:54rpx; height:54rpx; }
.outcome-row { display:flex; gap:18rpx; padding:22rpx 0; border-top:1rpx solid #EDF1F7; color:#52627A; font-size:25rpx; line-height:1.55; }
.outcome-num { color:#176BFF; font-weight:700; }
.form-head { margin:8rpx 0 26rpx; }
.step-card { padding:24rpx 26rpx; }
.progress { height:6rpx; border-radius:999rpx; background:#E9EFF8; overflow:hidden; }
.progress-fill { height:100%; border-radius:999rpx; background:linear-gradient(90deg,#176BFF,#2D8CFF); }
.step-1{width:33.33%}.step-2{width:66.66%}.step-3{width:100%}
.step-labels { display:flex; justify-content:space-between; margin-top:20rpx; }
.step-label { width:31%; color:#94A0B1; font-size:20rpx; }
.step-label.active { color:#081B3A; }
.step-index { color:#176BFF; font-size:18rpx; font-weight:700; }
.form-card { margin-top:22rpx; padding:34rpx 30rpx 38rpx; }
.form-title { color:#081B3A; font-size:33rpx; font-weight:650; }
.form-desc { margin-top:8rpx; color:#7B879B; font-size:22rpx; line-height:1.6; }
.field { margin-top:30rpx; }
.field-label { display:block; margin-bottom:12rpx; color:#20324F; font-size:25rpx; font-weight:600; }
input,textarea,.select-field,.phone-locked { width:100%; border:1rpx solid #DCE5F1; border-radius:20rpx; background:#FBFCFE; color:#0B1F3A; font-size:26rpx; }
input { height:90rpx; padding:0 22rpx; }
textarea { min-height:110rpx; padding:22rpx; }
.select-field,.phone-locked { display:flex; align-items:center; justify-content:space-between; min-height:90rpx; padding:0 22rpx; }
.phone-tag { padding:7rpx 12rpx; border-radius:999rpx; background:#EFF5FF; color:#176BFF; font-size:20rpx; }
.privacy-row { display:flex; gap:12rpx; margin-top:20rpx; color:#66789A; font-size:22rpx; }
.check { width:32rpx; height:32rpx; border:2rpx solid #AAB6C6; border-radius:8rpx; }
.check.checked { background:#176BFF; border-color:#176BFF; }
.bottom-actions { display:flex; gap:14rpx; margin-top:26rpx; }
.half-button { flex:1; }
.form-consult { display:block; margin-top:20rpx; color:#176BFF; text-align:center; font-size:23rpx; }
.field-error,.submit-error { margin-top:10rpx; color:#D85B67; font-size:21rpx; }
