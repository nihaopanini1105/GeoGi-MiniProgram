.diagnosis-page { padding-top: 20rpx; background: #F7F9FC; }
.page-kicker,.section-kicker { display:block; color:#176BFF; font-size:20rpx; font-weight:700; letter-spacing:.1em; }
.auth-card,.intro-hero,.platform-card,.outcome-card,.note-card,.step-card,.form-card { padding:32rpx; }
.auth-card,.intro-hero,.platform-card,.outcome-card,.note-card,.step-card,.form-card { background:#FFFFFF; border:1rpx solid #E3EAF5; border-radius:30rpx; box-shadow:0 14rpx 42rpx rgba(34,75,140,.07); }
.auth-card { min-height:620rpx; padding-top:46rpx; }
.auth-icon { width:92rpx; height:92rpx; margin-bottom:30rpx; }
.auth-title,.auth-copy,.intro-title,.intro-lead,.section-title,.note-title,.note-copy,.form-page-title,.form-page-copy,.form-title,.form-desc,.field-label,.field-help,.field-error,.submit-error { display:block; }
.auth-title,.intro-title { margin-top:16rpx; color:#081B3A; font-size:42rpx; font-weight:700; line-height:1.32; }
.auth-copy,.intro-lead { margin-top:16rpx; color:#66789A; font-size:26rpx; line-height:1.65; }
.auth-points { margin-top:34rpx; }
.auth-point { display:flex; align-items:center; gap:14rpx; min-height:54rpx; color:#52627A; font-size:24rpx; }
.point-dot { width:12rpx; height:12rpx; border-radius:50%; background:#176BFF; flex:0 0 auto; }
.auth-button,.intro-button { width:100%; min-height:94rpx; margin-top:38rpx; }
.privacy-link { min-height:60rpx; margin-top:12rpx; color:#176BFF; font-size:23rpx; font-weight:600; text-align:left; }
.intro-hero { position:relative; min-height:440rpx; overflow:hidden; background:linear-gradient(150deg,#FFFFFF,#F5F9FF); }
.intro-copy { position:relative; z-index:3; max-width:540rpx; }
.intro-orbit { position:absolute; z-index:1; right:-170rpx; top:-20rpx; width:500rpx; height:500rpx; opacity:.22; }
.section-headline { margin-bottom:26rpx; }
.section-title { margin-top:8rpx; color:#081B3A; font-size:34rpx; font-weight:650; line-height:1.35; }
.platform-grid { display:flex; justify-content:space-between; align-items:flex-start; }
.platform-item { display:flex; flex-direction:column; align-items:center; width:20%; color:#52627A; font-size:20rpx; text-align:center; }
.platform-icon-wrap { display:flex; align-items:center; justify-content:center; width:72rpx; height:72rpx; margin-bottom:10rpx; border:1rpx solid #E1E9F5; border-radius:20rpx; background:#FFF; box-shadow:0 8rpx 20rpx rgba(34,75,140,.06); }
.platform-icon-wrap image { width:54rpx; height:54rpx; }
.outcome-list { margin-top:22rpx; }
.outcome-row { display:flex; gap:18rpx; padding:22rpx 0; border-top:1rpx solid #EDF1F7; color:#52627A; font-size:25rpx; line-height:1.55; }
.outcome-num { color:#176BFF; font-weight:700; flex:0 0 auto; }
.note-title { color:#081B3A; font-size:29rpx; font-weight:650; }
.note-copy { margin-top:8rpx; color:#66789A; font-size:23rpx; line-height:1.6; }
.consult-link,.form-consult { display:block; margin-top:20rpx; color:#176BFF; font-size:23rpx; font-weight:600; }
.form-head { margin:8rpx 0 26rpx; }
.form-page-title { margin-top:12rpx; color:#081B3A; font-size:42rpx; font-weight:700; line-height:1.3; }
.form-page-copy { margin-top:10rpx; color:#66789A; font-size:23rpx; line-height:1.58; }
.step-card { padding:24rpx 26rpx; }
.progress { height:6rpx; border-radius:999rpx; background:#E9EFF8; overflow:hidden; }
.progress-fill { height:100%; border-radius:999rpx; background:linear-gradient(90deg,#176BFF,#2D8CFF); }
.step-1{width:33.33%}.step-2{width:66.66%}.step-3{width:100%}
.step-labels { display:flex; justify-content:space-between; margin-top:20rpx; }
.step-label { width:31%; color:#94A0B1; font-size:20rpx; line-height:1.35; }
.step-label text { display:block; }
.step-label.active { color:#081B3A; }
.step-index { margin-bottom:5rpx; color:#9CB7E8; font-size:18rpx; font-weight:700; }
.step-label.active .step-index { color:#176BFF; }
.form-card { margin-top:22rpx; padding:34rpx 30rpx 38rpx; }
.form-section-head { padding-bottom:24rpx; border-bottom:1rpx solid #EDF1F7; }
.form-title { color:#081B3A; font-size:33rpx; font-weight:650; }
.form-desc { margin-top:8rpx; color:#7B879B; font-size:22rpx; line-height:1.6; }
.field { margin-top:30rpx; }
.field-label-row { display:flex; align-items:center; justify-content:space-between; margin-bottom:12rpx; }
.field-label { margin-bottom:12rpx; color:#20324F; font-size:25rpx; font-weight:600; }
.field-label-row .field-label { margin-bottom:0; }
.field-label.required::after { content:' *'; color:#FF6B78; }
.optional-tag { color:#98A4B5; font-size:20rpx; }
input,textarea,.select-field,.phone-locked { width:100%; border:1rpx solid #DCE5F1; border-radius:20rpx; background:#FBFCFE; color:#0B1F3A; font-size:26rpx; }
input { height:90rpx; padding:0 22rpx; }
textarea { min-height:110rpx; padding:22rpx; line-height:1.55; }
.select-field,.phone-locked { display:flex; align-items:center; justify-content:space-between; min-height:90rpx; padding:0 22rpx; }
.select-field.empty,.placeholder { color:#A1ADBE; }
.select-arrow { width:13rpx; height:13rpx; border-right:3rpx solid #8D9CB1; border-bottom:3rpx solid #8D9CB1; transform:rotate(45deg); }
.field-help { margin-top:9rpx; color:#8A97A9; font-size:20rpx; }
.field-help-before { margin:-3rpx 0 14rpx; }
.chip-grid { display:flex; flex-wrap:wrap; gap:10rpx; }
.select-chip { min-height:66rpx; padding:0 18rpx; border:1rpx solid #DCE5F1; border-radius:999rpx; background:#FFF; color:#65758D; font-size:22rpx; }
.select-chip.active { border-color:#92B9FF; background:#EFF5FF; color:#176BFF; }
.upload-button { display:flex; align-items:center; justify-content:center; gap:10rpx; width:100%; min-height:88rpx; border:1rpx dashed #AFC8F7; border-radius:20rpx; background:#F7FAFF; color:#176BFF; font-size:23rpx; font-weight:600; }
.upload-button image { width:32rpx; height:32rpx; }
.upload-list { margin-top:12rpx; }
.upload-item { display:flex; align-items:center; justify-content:space-between; min-height:68rpx; padding:0 16rpx; border-radius:16rpx; background:#F7F9FC; color:#52627A; font-size:22rpx; }
.upload-item + .upload-item { margin-top:8rpx; }
.upload-item button { color:#D85B67; font-size:21rpx; }
.field-error,.submit-error { margin-top:10rpx; color:#D85B67; font-size:21rpx; line-height:1.45; }
.submit-error { padding:14rpx 16rpx; border:1rpx solid #FFD9DE; border-radius:16rpx; background:#FFF7F8; }
.phone-locked { color:#20324F; font-weight:600; }
.phone-tag { padding:7rpx 12rpx; border-radius:999rpx; background:#EFF5FF; color:#176BFF; font-size:20rpx; }
.privacy-row { display:flex; gap:12rpx; margin-top:30rpx; color:#66789A; font-size:22rpx; line-height:1.55; }
.check { width:32rpx; height:32rpx; margin-top:2rpx; border:2rpx solid #AAB6C6; border-radius:8rpx; flex:0 0 auto; }
.check.checked { border-color:#176BFF; background:#176BFF; }
.bottom-actions { display:flex; gap:14rpx; margin-top:26rpx; }
.half-button { flex:1; }
.form-consult { text-align:center; }
