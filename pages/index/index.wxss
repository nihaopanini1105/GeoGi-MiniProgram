.index-page {
  padding-top: 0;
  overflow-x: hidden;
  background: #FFFFFF;
}

.top-safe {
  height: 10rpx;
}

.hero {
  position: relative;
  min-height: 760rpx;
  padding: 46rpx 38rpx 44rpx;
  border: 1rpx solid #E2EAF7;
  border-radius: 36rpx;
  background: linear-gradient(150deg, #FFFFFF 0%, #FBFDFF 58%, #F2F7FF 100%);
  box-shadow: 0 18rpx 54rpx rgba(35, 80, 150, 0.08);
  overflow: hidden;
}

.brand-row {
  position: relative;
  z-index: 3;
  display: flex;
  align-items: center;
}

.brand-logo {
  width: 270rpx;
  height: auto;
}

.hero-bg {
  position: absolute;
  z-index: 1;
  right: -135rpx;
  top: 82rpx;
  width: 620rpx;
  height: 620rpx;
  opacity: 0.42;
}

.hero-copy {
  position: relative;
  z-index: 3;
  margin-top: 48rpx;
}

.hero-kicker,
.section-eyebrow {
  display: block;
  color: #176BFF;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1.35;
  letter-spacing: 0.12em;
}

.hero-title {
  display: block;
  max-width: 610rpx;
  margin-top: 28rpx;
  color: #081B3A;
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1.28;
  white-space: pre-line;
}

.hero-lead {
  display: block;
  max-width: 500rpx;
  margin-top: 28rpx;
  color: #64738A;
  font-size: 27rpx;
  line-height: 1.7;
}

.hero-actions {
  display: flex;
  margin-top: 44rpx;
}

.hero-primary {
  width: 420rpx;
  min-height: 94rpx;
  gap: 14rpx;
}

.hero-primary image {
  width: 30rpx;
  height: 30rpx;
}

.section-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.section-title {
  display: block;
  margin-top: 10rpx;
  color: #081B3A;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.3;
}

.platform-section {
  margin-top: 48rpx;
}

.platform-card {
  margin-top: 24rpx;
  padding: 30rpx 16rpx 26rpx;
}

.platform-grid {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.platform-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 20%;
  color: #52627A;
  font-size: 20rpx;
  font-weight: 500;
  text-align: center;
}

.platform-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  margin-bottom: 12rpx;
  border: 1rpx solid #E1E9F5;
  border-radius: 22rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(32, 70, 130, 0.08);
}

.platform-logo {
  width: 58rpx;
  height: 58rpx;
}

.services-section {
  margin-top: 52rpx;
  padding-bottom: 12rpx;
}

.safe-bottom {
  height: calc(70rpx + env(safe-area-inset-bottom));
}
