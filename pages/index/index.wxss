.index-page {
  padding-top: 0;
  overflow-x: hidden;
  background: #FFFFFF;
}

.top-safe {
  height: 10rpx;
}

.hero {
  position: relative;
  min-height: 760rpx;
  padding: 46rpx 38rpx 44rpx;
  border: 1rpx solid #E2EAF7;
  border-radius: 36rpx;
  background: linear-gradient(150deg, #FFFFFF 0%, #FBFDFF 58%, #F2F7FF 100%);
  box-shadow: 0 18rpx 54rpx rgba(35, 80, 150, 0.08);
  overflow: hidden;
}

.brand-row {
  position: relative;
  z-index: 3;
  display: flex;
  align-items: center;
}

.brand-logo {
  width: 270rpx;
  height: auto;
}

.hero-bg {
  position: absolute;
  z-index: 1;
  right: -135rpx;
  top: 82rpx;
  width: 620rpx;
  height: 620rpx;
  opacity: 0.42;
}

.hero-copy {
  position: relative;
  z-index: 3;
  margin-top: 48rpx;
}

.hero-kicker,
.section-eyebrow {
  display: block;
  color: #176BFF;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1.35;
  letter-spacing: 0.12em;
}

.hero-title {
  display: block;
  max-width: 610rpx;
  margin-top: 28rpx;
  color: #081B3A;
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1.28;
  white-space: pre-line;
}

.hero-lead {
  display: block;
  max-width: 500rpx;
  margin-top: 28rpx;
  color: #64738A;
  font-size: 27rpx;
  line-height: 1.7;
}

.hero-actions {
  display: flex;
  margin-top: 44rpx;
}

.hero-primary {
  width: 420rpx;
  min-height: 94rpx;
  gap: 14rpx;
}

.hero-primary image {
  width: 30rpx;
  height: 30rpx;
}

.section-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.section-title {
  display: block;
  margin-top: 10rpx;
  color: #081B3A;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.3;
}

.platform-section {
  margin-top: 48rpx;
}

.platform-card {
  margin-top: 24rpx;
  padding: 30rpx 16rpx 26rpx;
}

.platform-grid {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.platform-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 20%;
  color: #52627A;
  font-size: 20rpx;
  font-weight: 500;
  text-align: center;
}

.platform-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  margin-bottom: 12rpx;
  border: 1rpx solid #E1E9F5;
  border-radius: 22rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(32, 70, 130, 0.08);
}

.platform-logo {
  width: 58rpx;
  height: 58rpx;
}

.services-section {
  margin-top: 52rpx;
  padding-bottom: 12rpx;
}

.safe-bottom {
  height: calc(70rpx + env(safe-area-inset-bottom));
}


.section-copy {
  display: block;
  margin-top: 14rpx;
  color: #66789A;
  font-size: 24rpx;
  line-height: 1.65;
}

.service-list {
  margin-top: 24rpx;
}

.service-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 154rpx;
  padding: 26rpx 24rpx;
}

.service-card + .service-card {
  margin-top: 16rpx;
}

.service-icon-wrap {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: 78rpx;
  height: 78rpx;
  border-radius: 22rpx;
  background: #F0F5FF;
}

.service-icon-wrap image {
  width: 42rpx;
  height: 42rpx;
}

.service-copy {
  flex: 1;
  min-width: 0;
}

.service-title {
  display: block;
  color: #102541;
  font-size: 29rpx;
  font-weight: 650;
  line-height: 1.35;
}

.service-desc {
  display: block;
  margin-top: 7rpx;
  color: #6B7B92;
  font-size: 22rpx;
  line-height: 1.55;
}

.service-arrow {
  flex: 0 0 auto;
  color: #9AA8BB;
  font-size: 40rpx;
  line-height: 1;
}

.contact-panel {
  margin-top: 48rpx;
  padding: 34rpx 30rpx;
  background: linear-gradient(145deg, #F8FBFF, #EEF5FF);
}

.contact-eyebrow {
  display: block;
  color: #176BFF;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1.35;
  letter-spacing: 0.12em;
}

.contact-title {
  display: block;
  margin-top: 10rpx;
  color: #081B3A;
  font-size: 35rpx;
  font-weight: 700;
  line-height: 1.35;
}

.contact-copy {
  display: block;
  margin-top: 13rpx;
  color: #66789A;
  font-size: 24rpx;
  line-height: 1.65;
}

.contact-actions {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 26rpx;
}

.contact-button {
  width: 100%;
}

/* EXPERIENCE_V1_HOME_START */

.hero-actions {
  align-items: center;
}

.hero-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 420rpx;
  min-height: 94rpx;
  padding: 0 36rpx;
  gap: 0;
  text-align: center;
}

.hero-primary text {
  display: block;
  width: 100%;
  text-align: center;
  line-height: 1.2;
}

.platform-card {
  padding: 30rpx 14rpx 28rpx;
}

.platform-grid {
  align-items: flex-start;
}

.platform-item {
  min-width: 0;
  color: #52627A;
  font-size: 19rpx;
  line-height: 1.35;
}

.platform-item > text {
  display: block;
  width: 100%;
  text-align: center;
  white-space: nowrap;
}

.platform-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 84rpx;
  height: 84rpx;
  margin-bottom: 13rpx;
  padding: 10rpx;
  border: 1rpx solid #E5ECF6;
  border-radius: 24rpx;
  background: #F8FAFD;
  box-shadow: none;
  overflow: hidden;
}

.platform-logo {
  display: block;
  width: 62rpx;
  height: 62rpx;
  border-radius: 17rpx;
}

.service-card {
  border-color: #E6ECF5;
  box-shadow: 0 10rpx 30rpx rgba(32, 70, 130, 0.055);
}

.service-card:active {
  background: #FAFCFF;
}

.contact-panel {
  border-color: #DDE8F8;
  box-shadow: 0 12rpx 34rpx rgba(32, 70, 130, 0.06);
}

.contact-button {
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}
/* EXPERIENCE_V1_HOME_END */

/* EXPERIENCE_V1_PLATFORM_FINAL_START */
.platform-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  margin-bottom: 13rpx;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
  overflow: visible;
}

.platform-logo {
  display: block;
  width: 66rpx;
  height: 66rpx;
  border-radius: 18rpx;
}

.platform-item {
  justify-content: flex-start;
}

.platform-item > text {
  margin-top: 2rpx;
  color: #5F6F87;
  font-size: 19rpx;
  line-height: 1.35;
}
/* EXPERIENCE_V1_PLATFORM_FINAL_END */
